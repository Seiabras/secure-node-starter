# Copy to .env for local development (npm start reads it). On the server, install-once.sh writes /opt/<site>/.env
# with NODE_ENV=production and a random SECRET. Never commit .env: it is in .gitignore and gitleaks runs in CI.

# Where Node listens. Keep 127.0.0.1: the reverse proxy (Caddy) is what faces the internet.
HOST=127.0.0.1
PORT=8080
# 1 only behind a proxy that appends X-Forwarded-For (Caddy does). Without a proxy, leave it 0, or anyone could
# pick their own "IP" and walk past the rate limits.
TRUST_PROXY=0
# Database and secrets, outside the code folder.
DATA_DIR=./local-data
# The public address, used in canonical links. On the server: https://<your domain>.
SITE_URL=http://localhost:8080
SITE_NAME=Secure Node Starter
# The language of the site: en or pt-BR (pages, error messages and e-mails).
SITE_LANG=en
# Shown on error pages and in the "suspended account" message.
CONTACT_EMAIL=
# Keys the HMAC of the sign-in codes: at least 32 random characters (head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n').
# Without it a development secret is created in DATA_DIR; in production the server refuses to start.
SECRET=
# Accounts that can open /admin, comma-separated.
ADMIN_EMAILS=
# Sending the sign-in code (https://resend.com). Without a key nothing is sent.
RESEND_API_KEY=
MAIL_FROM=
# Development only: print the sign-in code in this terminal instead of e-mailing it. Ignored in production.
DEV_PRINT_CODE=1
NODE_ENV=development
