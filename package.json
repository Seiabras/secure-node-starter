{
  "name": "secure-node-starter",
  "version": "0.1.0",
  "private": true,
  "description": "A zero-dependency Node.js starting point with security controls built in and checked in CI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/server.mjs",
    "dev": "DEV_PRINT_CODE=1 node --env-file-if-exists=.env --watch server/server.mjs",
    "test": "node --test --test-reporter=spec \"test/*.test.mjs\"",
    "check:headers": "node scripts/check-headers.mjs",
    "check:html": "npx --yes html-validate@10.1.2 \"public/**/*.html\""
  }
}
